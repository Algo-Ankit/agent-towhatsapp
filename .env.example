# Copy to .env and fill in. Keep DRY_RUN=1 until Meta setup is done.
DRY_RUN=1

# ---------- WhatsApp (Meta Cloud API) ----------
# Meta App Dashboard > WhatsApp > API Setup
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Meta App Dashboard > App settings > Basic > App secret
WA_APP_SECRET=
# Any string; paste the same value into Meta's webhook "Verify token" field
WA_VERIFY_TOKEN=change-me
GRAPH_API_VERSION=v23.0

# ---------- Your agents ----------
# Leave empty to use the built-in stand-ins. Set to your friend's agent endpoints to use the real ones.
INVENTORY_AGENT_URL=
SUPPORT_AGENT_URL=
# Optional: sent as "Authorization: Bearer <key>" to both agent URLs
AGENT_API_KEY=
